# ElevenLabs Instant Voice Clone
# Get an API key at https://elevenlabs.io/app/settings/api-keys
# After `reelyshorts voice setup`, the chosen voice_id is stored in brands/<brand>/voice.json
ELEVENLABS_API_KEY=

# Optional: override default model
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: faster-whisper model size for voice timing
# tiny | base | small | medium | large-v3
# WHISPER_MODEL=base
